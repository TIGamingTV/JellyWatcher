# JellyWatcher environment. Every value is optional; the defaults work for a LAN install.
# Service connections (Jellyfin, Seerr, TMDb, Trakt) are configured in the web UI, not here.

# Host port published by compose.yaml.
JW_HOST_PORT=8484

# Time zone for log timestamps.
TZ=UTC

# Public address people use to open JellyWatcher, e.g. behind a reverse proxy.
# Used for cross-site request checks. Leave empty for direct LAN access.
JW_PUBLIC_URL=

# Set to true when running behind a reverse proxy that sets X-Forwarded-* headers.
JW_TRUST_PROXY=false

# Session cookie Secure flag: auto (secure when the request arrived over HTTPS), true, or false.
JW_COOKIE_SECURE=auto

# Encryption key for stored credentials. If empty, a random key is generated at /data/secret.key.
# Use 64 hex characters (generate with: openssl rand -hex 32). Keep it safe: without it, stored
# credentials cannot be decrypted and must be re-entered.
JW_SECRET_KEY=

# Optional fixed first-run setup code. If empty, a one-time code is printed to the container log.
JW_SETUP_TOKEN=

# Days a sign-in stays valid without use (sliding expiry).
JW_SESSION_TTL_DAYS=30

# trace | debug | info | warn | error
JW_LOG_LEVEL=info

# Also write logs to /data/logs/jellywatcher.log (rotated at 10 MB on start).
JW_LOG_FILE=true
