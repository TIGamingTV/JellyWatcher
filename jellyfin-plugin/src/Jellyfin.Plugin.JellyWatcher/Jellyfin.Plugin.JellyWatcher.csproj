<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.JellyWatcher</RootNamespace>
    <!-- Plugin version: the JellyWatcher version plus a fourth part (0.5.0 → 0.5.0.0). -->
    <Version>0.5.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <JellyfinVersion>12.0.0</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\client.js" LogicalName="Jellyfin.Plugin.JellyWatcher.Web.client.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.JellyWatcher.Tests" />
  </ItemGroup>

  <!-- The Watchlists page is written in TypeScript (../../client) and bundled with esbuild. -->
  <Target Name="BuildJellyWatcherClient" BeforeTargets="BeforeBuild" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="node scripts/build-plugin-client.mjs" WorkingDirectory="$(MSBuildThisFileDirectory)../../.." />
  </Target>

</Project>
